{
  "expo": {
    "name": "Forja",
    "slug": "forja",
    "scheme": "forja",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0B",
    "primaryColor": "#FF5B1F",
    "android": {
      "versionCode": 4,
      "package": "com.pessoal.treino",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP"
      ]
    },
    "ios": {
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "127.0.0.1": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "./plugins/with-short-cmake-paths",
      "./plugins/with-local-ai",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF5B1F"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O Forja usa a câmera para você tirar fotos do seu progresso.",
          "photosPermission": "O Forja abre suas fotos para você escolher fotos do seu progresso.",
          "microphonePermission": false
        }
      ],
      "react-native-health-connect",
      "./plugins/with-health-permissions",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "description": "Treino, nutrição e diário no seu celular. Dados locais e importação opcional com Gemini."
  }
}
